      "amount": "1 tsp"
    },
    {
      "name": "Olive Oil",
      "amount": "1/4 cup"
    },
    {
      "name": "Soy Sauce",
      "amount": "2 tbsp"
    },
    {
      "name": "Honey",
      "amount": "1 tsp"
    }
  ],
  "instructions": [
    "Preheat oven to 375°F (190°C).",
    "Cut bao in half horizontally and place them on a baking sheet.",
    "In a small bowl, mix together Chinese Five-Spice Powder and Olive Oil. Brush the mixture onto both sides of the bao.",
    "Top each bao half with a spoonful of Colby Cheese, Light Cheese, and Jack Cheese. Drizzle with Soy Sauce and sprinkle with Honey.",
    "Bake for 5-7 minutes or until the cheese is melted and the bao is crispy.",
    "Serve immediately."
  ],
