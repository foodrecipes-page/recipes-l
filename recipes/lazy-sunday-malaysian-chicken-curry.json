    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat the oil in a large pan over medium heat",
    "Add the onion and cook until softened, about 5 minutes",
    "Add the garlic and cook for 1 minute",
    "Add the curry powder and cook for 1 minute, stirring constantly",
    "Add the chicken and cook until browned, about 5 minutes",
    "Add the coconut milk, yoghurt, and lime juice, and stir to combine",
    "Bring the mixture to a simmer and cook until the chicken is cooked through, about 10 minutes",
    "Season with salt to taste",
    "Serve hot, garnished with fresh herbs if desired"
