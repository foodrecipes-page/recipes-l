  "ingredients": [
    {
      "name": "pork belly",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "rosemary",
      "amount": "2 sprigs",
      "notes": "fresh"
    },
    {
      "name": "gochujang",
      "amount": "2 tablespoons"
    },
    {
      "name": "soy sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "brown sugar",
      "amount": "1 tablespoon"
    },
    {
      "name": "heavy cream",
      "amount": "1 cup"
    },
    {
      "name": "sesame oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "lettuce leaves",
      "amount": "12",
      "notes": "for ssam"
    },
    {
      "name": "rice",
      "amount": "2 cups",
      "notes": "cooked"
    },
    {
      "name": "green chili",
      "amount": "1",
      "notes": "sliced"
    }
  ],
  "instructions": [
    "In a large pot, heat the sesame oil over medium heat.",
    "Add the pork belly and cook until browned on all sides.",
    "Add the rosemary sprigs, gochujang, soy sauce, and brown sugar, and stir to combine.",
    "Pour in the heavy cream and bring the mixture to a simmer.",
    "Reduce the heat to low and let cook for 1 hour, or until the pork is tender.",
    "Season with salt and pepper to taste.",
    "To assemble the ssam, place a few pieces of the pork onto a lettuce leaf, followed by a spoonful of rice and a slice of green chili.",
    "Serve immediately and enjoy.",
    "Garnish with additional rosemary sprigs if desired."
  ],
