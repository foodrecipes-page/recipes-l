{
  "title": "Light Saudi Arabian Eggplant Bake",
  "description": "A winey, fluffy, romantic Saudi-Arabian dish featuring garlic granules, perfect for a special occasion.",
  "cuisine": "Saudi Arabian",
  "diet": [
    "ovo-vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "eggplant",
      "amount": "2 medium",
      "notes": "sliced into 1/4 inch thick rounds"
    },
    {
      "name": "garlic granules",
      "amount": "1 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbly"
    },
    {
      "name": "tomato sauce",
      "amount": "1 cup"
    },
    {
      "name": "bread crumbs",
      "amount": "1/4 cup"
    },
    {
      "name": "eggs",
      "amount": "2 large"
    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, garlic granules, salt, and black pepper.",
    "Add the sliced eggplant to the bowl and toss to coat with the oil mixture.",
    "In a separate bowl, whisk together tomato sauce and eggs.",
    "In a greased ramekin, create a layer of eggplant slices.",
    "Pour some of the tomato sauce mixture over the eggplant layer.",
    "Sprinkle some feta cheese and bread crumbs over the sauce.",
    "Repeat the layers until all ingredients are used, ending with a layer of cheese on top.",
    "Bake for 35 minutes or until the top is golden brown.",
    "Garnish with parsley and serve hot."
  ],
