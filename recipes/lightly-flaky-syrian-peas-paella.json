  "ingredients": [
    {
      "name": "petit pois",
      "amount": "1 cup",
      "notes": "fresh or frozen"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "saffron threads",
      "amount": "1/2 teaspoon",
      "notes": "soaked in 1 tablespoon hot water"
    },
    {
      "name": "vegetable broth",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat the olive oil in a paella pan over medium heat.",
    "Add the chopped onion and cook until translucent, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Stir in the smoked paprika, salt, and black pepper.",
    "Add the petit pois, saffron threads with their soaking liquid, and vegetable broth to the paella pan.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer, covered, for 20 minutes.",
    "Use a spatula to shape the mixture into nigiri-like shapes.",
    "Serve the Syrian peas paella hot, garnished with fresh herbs if desired."
  ],
