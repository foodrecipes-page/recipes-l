      "name": "pork shoulder",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "dried red chillies",
      "amount": "2",
      "notes": "crushed"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "cedar planks",
      "amount": "4",
      "notes": "soaked in water for 30 minutes"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat.",
    "In a large bowl, whisk together olive oil, crushed dried red chillies, garlic, salt, and black pepper.",
    "Add the pork pieces to the bowl and toss to coat with the marinade.",
    "Thread the marinated pork pieces onto the soaked cedar planks.",
    "Place the cedar planks on the grill and cook for 10-12 minutes per side, or until the pork is cooked through.",
    "Let the kebabs rest for 5 minutes before serving.",
    "Serve hot and enjoy!",
    "Garnish with fresh herbs, if desired."
  ],
