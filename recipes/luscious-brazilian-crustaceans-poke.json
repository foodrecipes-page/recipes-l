      "notes": "frozen or fresh"
    },
    {
      "name": "1/4 cup coconut milk",
      "amount": "",
      "notes": "full-fat"
    },
    {
      "name": "2 tablespoons honey",
      "amount": "",
      "notes": ""
    },
    {
      "name": "2 tablespoons soy sauce",
      "amount": "",
      "notes": "low-sodium"
    },
    {
