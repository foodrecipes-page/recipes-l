    {
      "name": "Anchovy paste",
      "amount": "1 tablespoon"
    },
    {
      "name": "Kombu broth",
      "amount": "2 cups"
    },
    {
      "name": "Toasted sesame seeds",
      "amount": "1 tablespoon",
      "notes": "for garnish"
    }
  ],
  "instructions": [
    "Heat the sesame oil in a large pot over medium heat.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the Korean chili flakes and cook for another minute.",
    "Add the pak choi and cook until it starts to wilt.",
    "Add the anchovy paste and kombu broth, and bring to a boil.",
    "Reduce the heat to low and simmer for 10 minutes.",
    "Season with salt to taste.",
    "Garnish with toasted sesame seeds and serve.",
    "Serve hot, garnished with additional sesame seeds if desired."
