{
  "title": "Lively Smoky Filipino Kale Kare Kare",
  "description": "A smoky and dense Filipino dish featuring kale and shio-cure, this kare kare is jain-friendly and packed with energizing flavors.",
  "cuisine": "Filipino",
  "diet": [
    "jain",
    "vegetarian"
