{
  "title": "Lightly Sweet Saudi Arabian Lamb Kebabs",
  "description": "A sour and pillowy Saudi Arabian dish featuring lamb kebabs with a hint of dark brown sugar, perfect for a meal prep dinner",
  "cuisine": "Saudi Arabian",
  "diet": [
    "sugar-free-friendly"
  ],
