  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "dark brown sugar",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "coriander",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat a deep fryer to 350 degrees Fahrenheit",
    "In a large bowl, whisk together lemon juice, olive oil, garlic, ginger, cumin, coriander, salt, and black pepper",
    "Add the lamb cubes to the bowl and marinate for at least 30 minutes",
    "Thread the marinated lamb cubes onto skewers",
    "Deep fry the lamb kebabs for 5 minutes or until cooked through",
    "In a small bowl, mix together dark brown sugar and 1 tablespoon of water to make a glaze",
    "Brush the glaze onto the lamb kebabs during the last minute of cooking",
    "Serve the lamb kebabs on a hot stone plate",
    "Garnish with fresh parsley and serve immediately"
  ],
