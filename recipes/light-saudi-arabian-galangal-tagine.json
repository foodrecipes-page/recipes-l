{
  "title": "Light Saudi Arabian Galangal Tagine",
  "description": "A cultured and crisp meal prep Saudi Arabian dish featuring galangal and bonito shave, low in carbs and cooked to perfection in a copper pot.",
  "cuisine": "Saudi Arabian",
  "diet": [
    "low-carb",
    "gluten-free"
