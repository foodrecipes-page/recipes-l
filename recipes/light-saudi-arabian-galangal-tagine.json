  "ingredients": [
    {
      "name": "galangal",
      "amount": "2 medium roots",
      "notes": "peeled and sliced"
    },
    {
      "name": "bonito flakes",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "chicken breast",
      "amount": "1 pound",
      "notes": "cut into bite sized pieces"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "cumin",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "coriander",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "chopped fresh parsley",
      "amount": "1/4 cup",
      "notes": "for garnish"
    }
  ],
  "instructions": [
    "Heat the olive oil in a copper pot over medium heat.",
    "Add the sliced galangal and cook for 5 minutes, stirring occasionally.",
    "Add the chicken breast pieces and cook until browned on all sides, about 5-7 minutes.",
    "Add the bonito flakes, salt, black pepper, cumin, and coriander, and stir to combine.",
    "Pour in the lemon juice and bring the mixture to a simmer.",
    "Reduce the heat to low and cook, covered, for 20 minutes, or until the chicken is cooked through.",
    "Remove the pot from the heat and garnish with chopped fresh parsley.",
    "Serve hot, garnished with additional parsley if desired."
  ],
