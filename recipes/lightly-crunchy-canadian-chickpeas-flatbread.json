    {
      "name": "hummus",
      "amount": "1/2 cup"
    },
    {
      "name": "double-rise-bread",
      "amount": "1 loaf"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "red wine vinegar",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Preheat the tava griddle over medium heat.",
    "Slice the double-rise-bread into 1/2 inch thick slices.",
    "Brush the slices with olive oil and sprinkle with garlic powder, salt, and black pepper.",
    "Place the slices on the preheated tava griddle and cook for 2-3 minutes on each side.",
    "Spread a layer of hummus on each slice.",
    "Top the hummus with chickpeas and a drizzle of red wine vinegar.",
    "Cook for an additional 2 minutes to warm the chickpeas and hummus.",
    "Remove from heat and serve immediately."
  ],
