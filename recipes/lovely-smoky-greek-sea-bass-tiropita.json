      "amount": "4 sheets"
    },
    {
      "name": "smoked paprika",
      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1/2 tsp"
    },
    {
      "name": "pepper",
      "amount": "1/4 tsp"
    },
    {
      "name": "olive oil",
      "amount": "2 tbsp"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a bowl, mix together feta cheese, kalamata olives, sun dried tomatoes, and chopped candy.",
    "Season the sea bass fillets with smoked paprika, salt, and pepper.",
    "Brush the filo dough sheets with olive oil.",
    "Place a sea bass fillet on each filo dough sheet.",
    "Spoon the feta cheese mixture on top of each sea bass fillet.",
    "Fold the filo dough sheets to form a triangle and press the edges to seal.",
    "Place the tiropitas on a baking sheet lined with parchment paper.",
    "Bake the tiropitas for 20 minutes or until golden brown."
  ],
