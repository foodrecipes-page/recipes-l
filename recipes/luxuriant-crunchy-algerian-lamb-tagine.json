{
  "title": "Luxuriant Crunchy Algerian Lamb Tagine",
  "description": "A funky and crunchy Algerian dish featuring lamb, full fat sour cream, and yuzu cure, cooked to perfection on a comal.",
  "cuisine": "Algerian",
  "diet": [
    "low-fat-friendly"
  ],
