    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "full fat sour cream",
      "amount": "1 cup"
    },
    {
      "name": "yuzu juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "yuzu zest",
      "amount": "1 tablespoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "coriander",
      "amount": "1 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil on a comal over medium high heat.",
    "Add the chopped onion and cook until it is translucent and starting to brown.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the lamb pieces and cook until they are browned on all sides.",
    "Add the cumin, coriander, and paprika, and stir to combine.",
    "Add the yuzu juice and zest, and stir to combine.",
    "Reduce the heat to low and simmer, covered, for 1 1/2 hours.",
    "Stir in the full fat sour cream and cook for an additional 10 minutes.",
    "Season with salt and pepper to taste.",
    "Serve the tagine hot, garnished with chopped fresh herbs if desired."
  ],
