      "amount": "1 teaspoon"
    },
    {
      "name": "ground cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "star anise",
      "amount": "2 whole"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    },
    {
      "name": "beef broth",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat oil in a large Dutch oven over medium high heat.",
    "Add the beef to the pot and cook until browned on all sides.",
    "Remove the beef from the pot and set aside.",
    "Add the fish sauce, soy sauce, cinnamon, cumin, star anise, and black pepper to the pot and cook for 1 minute.",
    "Add the passata and beef broth to the pot and bring to a boil.",
    "Return the beef to the pot and reduce heat to low.",
    "Simmer the bo kho for 2 1/2 hours or until the beef is tender.",
    "Remove the star anise from the pot and serve the bo kho hot.",
    "Garnish with fresh herbs if desired."
  ],
