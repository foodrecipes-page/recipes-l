{
  "title": "Lazy Sunday Chinese Oats Noodles",
  "description": "A fresh and gooey Chinese dish featuring oats, robata-grill, and sugar-free friendly ingredients, perfect for a lazy Sunday morning.",
  "cuisine": "Chinese",
  "diet": [
    "sugar-free",
    "vegetarian"
