  "ingredients": [
    {
      "name": "rolled oats",
      "amount": "1 cup",
      "notes": "old-fashioned"
    },
    {
      "name": "water",
      "amount": "2 cups"
    },
    {
      "name": "soy sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "sesame oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "garlic",
      "amount": "1 clove",
      "notes": "minced"
    },
    {
      "name": "robata-grill tofu",
      "amount": "1/2 cup",
      "notes": "cubed"
    }
  ],
  "instructions": [
    "In a large pot, bring the water to a boil.",
    "Add the oats and reduce heat to low, simmering for 5 minutes.",
    "In a small bowl, whisk together the soy sauce and sesame oil.",
    "Add the scallions, ginger, and garlic to the bowl and stir to combine.",
    "Add the robata-grill tofu to the bowl and stir to combine.",
    "Fluff the cooked oats with a fork and stir in the tofu mixture.",
    "Serve the oats hot, garnished with additional scallions if desired.",
    "Let the dish cool for a few minutes before serving.",
    "Store any leftovers in an airtight container in the refrigerator."
  ],
