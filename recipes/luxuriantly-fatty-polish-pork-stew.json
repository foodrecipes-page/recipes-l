  "ingredients": [
    {
      "name": "pork shoulder",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "garlic granules",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the oil in a large cazuela over medium heat",
    "Add the pork and cook until browned on all sides",
    "Add the onion and cook until softened",
    "Add the garlic granules, salt, pepper, and paprika, and stir to combine",
    "Add the carrots and potatoes, and stir to combine",
    "Pour in enough water to cover the ingredients and bring to a boil",
    "Reduce the heat to low and simmer, covered, for 1 hour",
    "Remove the lid and continue to simmer for an additional 30 minutes",
    "Serve hot, garnished with chopped fresh parsley if desired"
  ],
