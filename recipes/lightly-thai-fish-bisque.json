  "ingredients": [
    {
      "name": "Fish (white firm variety)",
      "amount": "250g",
      "notes": "cut into small pieces"
    },
    {
      "name": "Coconut milk",
      "amount": "400ml",
      "notes": "full-fat for richness"
    },
    {
      "name": "Corn kernels",
      "amount": "2 ears",
      "notes": "fresh or frozen"
    },
    {
      "name": "Onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "Garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "Tom Yum paste",
      "amount": "2 tsp",
      "notes": "adjust to taste"
    },
    {
      "name": "Fish stock",
      "amount": "250ml",
      "notes": "homemade or store-bought"
    },
    {
      "name": "Lime juice",
      "amount": "2 tbsp",
      "notes": "freshly squeezed"
    },
    {
      "name": "Saffron threads",
      "amount": "10",
      "notes": "soaked in 2 tbsp hot water"
    }
  ],
  "instructions": [
    "Heat 2 tbsp of oil in a large saucepan over medium heat",
    "Add the onion and cook until softened, about 5 minutes",
    "Add the garlic and cook for another minute",
    "Add the fish and cook until opaque, about 3-4 minutes",
    "Add the coconut milk, fish stock, corn kernels, Tom Yum paste, and lime juice",
    "Bring the mixture to a simmer and cook for 10-12 minutes",
    "Stir in the soaked saffron threads and their liquid",
    "Use an immersion blender to puree the soup until smooth",
    "Taste and adjust seasoning as needed",
    "Serve immediately, garnished with a sprinkle of toasted peanuts or crispy shallots"
  ],
