{
  "title": "Lightly Thai Fish Bisque",
  "description": "A rich and pillowy one-pot Thai dish featuring sweetcorn, temper, and a pescatarian-friendly twist",
  "cuisine": "Thai",
  "diet": [
    "pescatarian"
  ],
