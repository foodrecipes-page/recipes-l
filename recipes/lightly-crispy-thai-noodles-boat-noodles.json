    {
      "name": "rice noodles",
      "amount": "8 oz",
      "notes": "preferably fresh"
    },
    {
      "name": "chicken bouillon powder",
      "amount": "2 tsp"
    },
    {
      "name": "vegetable oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "thinly sliced"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "soy sauce",
      "amount": "2 tbsp"
    },
    {
      "name": "sugar",
      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1/2 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/4 tsp"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the oil in a large skillet over medium-high heat.",
    "Add the sliced onion and cook until lightly browned.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the rice noodles and stir to combine with the onion and garlic.",
    "In a small bowl, whisk together the chicken bouillon powder, soy sauce, sugar, salt, and black pepper.",
    "Pour the whisked mixture over the noodles and stir to combine.",
    "Cook for an additional 2-3 minutes, until the noodles are lightly crispy.",
    "Stir in the chopped scallions.",
    "Serve the noodles in a tagliere, shaped like a boat.",
    "Garnish with additional scallions, if desired."
  ],
