{
  "title": "Lightly Crispy Thai Noodles Boat Noodles",
  "description": "A winey and crispy Thai dish featuring chicken bouillon powder, perfect for a date night, served in a tagliere as boat noodles.",
  "cuisine": "Thai",
  "diet": [
    "Jain"
  ],
