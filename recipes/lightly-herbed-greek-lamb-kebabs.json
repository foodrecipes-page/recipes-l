{
  "title": "Lightly Herbed Greek Lamb Kebabs",
  "description": "Rich and flavorful lamb kebabs with a side of wholegrain bread, perfect for a weeknight dinner",
  "cuisine": "Greek",
  "diet": [
    "gluten-free",
    "dairy-free"
  ],
