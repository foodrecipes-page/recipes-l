  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "wholegrain bread",
      "amount": "1 loaf",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "fresh oregano",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "fresh thyme",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat",
    "In a large bowl, whisk together olive oil, lemon juice, garlic, salt, and pepper",
    "Add the lamb cubes to the bowl and toss to coat with the marinade",
    "Thread the lamb cubes onto skewers, leaving a small space between each piece",
    "Grill the kebabs for 10-12 minutes, turning occasionally, until the lamb is cooked to an internal temperature of 145 degrees",
    "Meanwhile, toast the wholegrain bread cubes by grilling them for 2-3 minutes on each side",
    "Serve the kebabs with the toasted bread and a sprinkle of chopped oregano and thyme",
    "Wrap the kebabs and bread in papillote and serve immediately"
  ],
