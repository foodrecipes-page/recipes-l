    },
    {
      "name": "fresh cilantro",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Cook the rice noodles according to package instructions and set aside",
    "In a large bowl, whisk together ketchup, fish sauce, lime juice, and brown sugar",
    "Add the sliced pork to the bowl and marinate for at least 10 minutes",
    "Heat the vegetable oil in a large skillet over medium-high heat",
    "Remove the pork from the marinade and cook until browned and crispy",
    "Add the cooked noodles to the skillet and stir to combine with the pork",
    "Top the noodles with pickled carrots and chopped cilantro",
    "Serve immediately on a wooden board",
    "Garnish with additional cilantro and lime wedges if desired"
  ],
