  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "clotted cream",
      "amount": "1/2 cup"
    },
    {
      "name": "active dry yeast",
      "amount": "1 teaspoon"
    },
    {
      "name": "chickpeas",
      "amount": "1 can"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ground cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in the tandoor over medium heat",
    "Add the chopped onion and cook until softened, about 5 minutes",
    "Add the minced garlic and cook for an additional minute",
    "Add the lamb pieces and cook until browned on all sides, about 5 minutes",
    "Add the chickpeas, tomato paste, cumin, and paprika, and stir to combine",
    "Add 2 cups of water and bring the mixture to a boil",
    "Reduce the heat to low and simmer, covered, for 1 hour",
    "Stir in the clotted cream and active dry yeast, and continue to simmer for an additional 10 minutes",
    "Season with salt and pepper to taste, and serve hot"
  ],
