{
  "title": "Luxurious Yeasty Moroccan Lamb Harira",
  "description": "A rich and velvety Moroccan stew featuring lamb, clotted cream, and a blend of aromatic spices, cooked to perfection in a tandoor",
  "cuisine": "Moroccan",
  "diet": [
    "macrobiotic"
  ],
