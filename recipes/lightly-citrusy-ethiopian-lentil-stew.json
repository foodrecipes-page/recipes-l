{
  "title": "Lightly Citrusy Ethiopian Lentil Stew",
  "description": "A flavorful and aromatic one-pot stew featuring red lentils and a hint of citrus, cooked in vegan butter and served in a banana leaf vessel.",
  "cuisine": "Ethiopian",
  "diet": [
    "vegan",
