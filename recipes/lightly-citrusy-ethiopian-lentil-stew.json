  "ingredients": [
    {
      "name": "red lentils",
      "amount": "1 cup",
      "notes": "rinsed and drained"
    },
    {
      "name": "vegan butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "berbere spice",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the vegan butter in a large pot over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the red lentils, lemon juice, berbere spice, and salt, and stir to combine.",
    "Add 2 cups of water to the pot and bring to a boil.",
    "Reduce the heat to low and simmer, covered, for 20 minutes, or until the lentils are tender.",
    "Serve the stew hot, garnished with chopped fresh herbs, if desired, in a banana leaf vessel."
  ],
