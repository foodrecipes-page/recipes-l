  "instructions": [
    "Heat the olive oil in a large pan over medium heat.",
    "Add the chopped onion and saute until it is translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the diced eggplant, sliced zucchini, and diced red bell pepper, and cook for 5 minutes.",
    "Season with salt and black pepper to taste.",
    "Transfer the vegetable mixture to a bamboo steamer.",
    "In a small bowl, mix the greek yogurt with a pinch of salt and pepper.",
    "Place the bowl with the yogurt mixture in the steamer with the vegetables.",
    "Simmer the stew over low heat for 20 minutes.",
    "Garnish with chopped fresh parsley and serve hot."
  ],
