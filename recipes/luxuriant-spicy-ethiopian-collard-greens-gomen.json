  "instructions": [
    "Heat the oil in a large pot over medium heat.",
    "Add the chopped onion and saute until softened.",
    "Add the minced garlic and grated ginger and saute for 1 minute.",
    "Add the berbere spice and saute for 1 minute.",
    "Add the collard greens and saute until wilted.",
    "Add the treacle and stir to combine.",
    "Season with salt to taste.",
    "Steam the mixture using a mushimono-steam method for 10 minutes.",
    "Serve hot.",
    "Garnish with chopped fresh herbs if desired."
  ],
