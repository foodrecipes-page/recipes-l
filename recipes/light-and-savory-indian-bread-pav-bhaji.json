  "instructions": [
    "Soak the white bread in water for about 10 minutes until it softens.",
    "Heat ghee or oil in a large clay pot over medium heat.",
    "Add cumin powder, coriander powder, and turmeric powder, and sauté for a minute until fragrant.",
    "Add the onions and sauté until they are translucent and starting to brown.",
    "Add the tomatoes and sauté until they are soft and mushy.",
    "Add the potatoes and mushrooms, and sauté until they are cooked through.",
    "Add the green chilies, ginger, and garlic, and sauté for a minute until fragrant.",
    "Add the curry leaves and sauté for a minute until they are crispy.",
    "Add the pav bhaji masala and sauté for a minute until fragrant.",
    "Add 2 cups of water to the pot and bring to a boil.",
    "Add the soaked bread to the pot and mix well to combine.",
    "Add salt to taste and mix well to combine.",
    "Garnish with chopped cilantro and lemon juice.",
    "Serve hot and enjoy!"
  ],
