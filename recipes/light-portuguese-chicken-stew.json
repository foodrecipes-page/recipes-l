{
  "title": "Light Portuguese Chicken Stew",
  "description": "A comforting and flavorful stew featuring chicken, wine, and dried oregano, perfect for a weeknight dinner",
  "cuisine": "Portuguese",
  "diet": [
    "fodmap-friendly",
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "dried oregano",
      "amount": "2 teaspoons"
    },
    {
      "name": "infuse oil",
      "amount": "1/4 cup"
    },
    {
      "name": "white wine",
      "amount": "1 cup"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and cubed"
    },
    {
      "name": "carrots",
      "amount": "4 medium",
      "notes": "peeled and sliced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the infuse oil in the hot pot vessel over medium heat",
    "Add the chicken to the vessel and cook until browned on all sides",
    "Add the dried oregano, salt, and black pepper to the vessel and stir to combine",
    "Add the white wine to the vessel and bring to a boil",
    "Reduce the heat to low and simmer for 10 minutes",
    "Add the chicken broth, potatoes, and carrots to the vessel and stir to combine",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 20 minutes",
    "Serve the stew hot, garnished with fresh herbs if desired",
    "Ensure poultry is cooked to an internal temperature of 74°C / 165°F (juices run clear, no pink remaining) before serving."
  ],
