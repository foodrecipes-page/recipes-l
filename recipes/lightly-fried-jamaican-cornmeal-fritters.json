{
  "title": "Lightly Fried Jamaican Cornmeal Fritters",
  "description": "Nutty, creamy, comforting Jamaican cornmeal fritters, perfect as a snack or side dish",
  "cuisine": "jamaican",
  "diet": null,
  "meal": "snack",
  "ingredients": [
    {
      "name": "White Cornmeal",
      "amount": "1 1/2 cups"
    },
    {
      "name": "Granulated Sugar",
      "amount": "2 tablespoons"
    },
    {
      "name": "Salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "Black Pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "Cayenne Pepper",
      "amount": "1/8 teaspoon"
    },
    {
      "name": "Large Egg",
      "amount": "1"
    },
    {
      "name": "Milk",
      "amount": "1/2 cup"
    },
    {
      "name": "All-purpose Flour",
      "amount": "2 tablespoons"
    },
    {
      "name": "Unsalted Butter, Melted",
      "amount": "1 tablespoon"
    },
    {
      "name": "Coconut Oil",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "In a large bowl, whisk together cornmeal, sugar, salt, black pepper, and cayenne pepper.",
    "In a separate bowl, whisk together egg, milk, and melted butter.",
    "Add the wet ingredients to the dry ingredients and stir until combined.",
    "Add the flour and stir until just combined.",
    "Heat 1/2 cup of coconut oil in a large skillet over medium heat.",
    "Using a 1/4 cup measuring cup, scoop the batter into the skillet.",
    "Fry the fritters for 3-4 minutes on each side, or until golden brown and crispy.",
    "Drain the fritters on paper towels and serve hot."
  ],
