      "amount": "1 tablespoon"
    },
    {
      "name": "salt-free seasoning blend",
      "amount": "1 teaspoon"
    },
    {
      "name": "fresh basil leaves",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the oil in a clay pot over medium heat.",
    "Add the curry paste and cook for 1 minute, stirring constantly.",
    "Add the chicken and cook until browned, about 5 minutes.",
    "Add the cocoa powder, fish sauce, brown sugar, and seasoning blend, and stir to combine.",
    "Pour in the coconut milk and bring to a simmer.",
    "Reduce the heat to low and cook, covered, for 15 minutes.",
    "Stir in the lime juice and cook for an additional 2 minutes.",
    "Taste and adjust the seasoning as needed.",
    "Serve hot, garnished with chopped basil leaves."
