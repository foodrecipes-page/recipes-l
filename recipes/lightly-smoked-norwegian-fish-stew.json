    {
      "name": "cod fillets",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "Chinese five spice powder",
      "amount": "2 teaspoons"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and sliced"
    },
    {
      "name": "sea salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fish stock",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat",
    "Add the chopped onion and cook until softened, about 5 minutes",
    "Add the minced garlic and cook for an additional minute",
    "Add the Chinese five spice powder, smoked paprika, sea salt, and black pepper, and stir to combine",
    "Add the sliced carrots and cook for 5 minutes, or until they start to soften",
    "Add the cod fillets and fish stock, and bring the mixture to a boil",
    "Reduce the heat to low and simmer, covered, for 10 minutes, or until the fish is cooked through",
    "Serve hot, garnished with chopped fresh parsley or dill if desired"
  ],
