    {
      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into thin strips"
    },
    {
      "name": "dried mint",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "collard green leaves",
      "amount": "4 leaves"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "cayenne pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, lime juice, garlic, ginger, salt, black pepper, and cayenne pepper.",
    "Add the chicken to the bowl and toss to coat with the marinade.",
    "Let the chicken marinate for 30 minutes.",
    "Wrap each chicken strip in a collard green leaf and place on a baking sheet.",
    "Sprinkle dried mint over the chicken.",
    "Steam the chicken in the oven for 20 minutes.",
    "Serve the chicken wraps hot.",
    "Garnish with additional dried mint if desired."
  ],
