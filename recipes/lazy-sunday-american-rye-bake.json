      "amount": "1",
      "notes": ""
    },
    {
      "name": "honey",
      "amount": "2 tbsp",
      "notes": "adjust to taste"
    },
    {
      "name": "coconut oil",
      "amount": "1/4 cup",
      "notes": "melted"
    },
    {
