      "amount": "3/4 cup",
      "notes": "adjust to consistency"
    },
    {
      "name": "baking soda",
      "amount": "1 tsp",
      "notes": ""
    },
    {
      "name": "salt",
      "amount": "1/4 tsp",
      "notes": ""
    },
    {
      "name": "active dry yeast",
      "amount": "1 tsp",
      "notes": "optional"
    }
  ],
  "instructions": [
    "preheat the oven to 375 degrees fahrenheit.",
    "in a large bowl, combine the rye flour, baking soda, and salt.",
    "in a separate bowl, whisk together the melted coconut oil, honey, apple cider vinegar, and egg.",
    "add the wet ingredients to the dry ingredients and stir until just combined.",
    "gradually add the water, stirring until a sticky dough forms.",
    "knead the dough for 5 minutes until smooth and elastic.",
    "place the dough in a greased loaf pan.",
    "bake for 40 minutes, or until a toothpick comes out clean.",
    "let cool for 10 minutes before slicing and serving."
  ],
