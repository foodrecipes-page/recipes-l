{
  "title": "Lazy Latin Corn Bake",
  "description": "A comforting and easy to make Venezuelan dish featuring fresh corn and onion salt, perfect for a sick day. This ayurvedic tamasic friendly recipe is cooked to perfection on a comal.",
  "cuisine": "Venezuelan",
  "diet": [
    "vegetarian",
    "gluten free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "fresh corn kernels",
      "amount": "2 cups",
      "notes": "thawed if frozen"
    },
    {
      "name": "onion salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "mozzarella cheese",
      "amount": "1 cup",
      "notes": "shredded"
    },
    {
      "name": "chopped fresh cilantro",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "garlic powder",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the comal over medium heat.",
    "In a large bowl, mix together the corn kernels, onion salt, salt, black pepper, and garlic powder.",
    "Add the butter to the comal and let it melt.",
    "Add the corn mixture to the comal and cook for 5 minutes, stirring occasionally.",
    "Sprinkle the mozzarella cheese over the corn mixture and cook until the cheese is melted and bubbly.",
    "Remove the comal from the heat and sprinkle the chopped cilantro over the top.",
    "Let it cool for a few minutes before serving.",
    "Serve hot and enjoy."
  ],
