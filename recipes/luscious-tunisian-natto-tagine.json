  "instructions": [
    "heat the olive oil in a large clay pot or heavy pot over medium heat",
    "add the onion and cook, stirring occasionally, until softened, about 5 minutes",
    "add the garlic and cook, stirring constantly, for 1 minute",
    "add the natto, dates, date syrup, water, cumin, coriander, turmeric, cayenne pepper, salt, and black pepper",
    "stir to combine, then bring to a boil",
    "reduce heat to low and simmer, uncovered, for 10 minutes",
    "stir occasionally and adjust seasoning as needed",
    "serve hot, topped with toasted almonds"
  ],
