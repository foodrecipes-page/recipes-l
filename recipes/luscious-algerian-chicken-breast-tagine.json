      "amount": "2 cups"
    },
    {
      "name": "dried apricots",
      "amount": "1 cup"
    },
    {
      "name": "prunes",
      "amount": "1/2 cup"
    }
  ],
  "instructions": [
    "Heat the olive oil in the pressure cooker over medium heat.",
    "Add the chopped onion and cook until it is softened.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the cumin, coriander, and cayenne pepper and cook for 1 minute.",
    "Add the chicken breast and cook until it is browned on all sides.",
    "Add the chicken broth, dried apricots, and prunes.",
    "Close the lid of the pressure cooker and bring to high pressure.",
    "Cook for 20 minutes.",
    "Let the pressure release naturally.",
    "Serve the chicken breast and sauce over couscous or rice."
