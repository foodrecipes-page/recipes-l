{
  "title": "Lovely Venezuelan Shrimp Skewers",
  "description": "A romantic Venezuelan dish featuring saeujeot shrimp paste in a mustardy and silky glaze, perfect for a dinner date.",
  "cuisine": "Venezuelan",
  "diet": [
    "egg-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "large shrimp",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "saeujeot shrimp paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "Dijon mustard",
      "amount": "1 tablespoon"
    },
    {
      "name": "honey",
      "amount": "1 tablespoon"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the grill to medium high heat.",
    "In a blender or food processor, combine shrimp paste, mustard, honey, garlic, salt, and pepper, and blend until smooth.",
    "With the blender or food processor running, slowly pour in the olive oil through the top.",
    "Thread the shrimp onto skewers.",
    "Brush the shrimp with the shrimp paste glaze.",
    "Grill the shrimp for 2-3 minutes per side, or until pink and cooked through.",
    "Garnish with chopped parsley and serve immediately."
  ],
