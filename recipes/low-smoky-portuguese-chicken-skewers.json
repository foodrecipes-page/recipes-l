{
  "title": "Low Smoky Portuguese Chicken Skewers",
  "description": "A weeknight Portuguese dish featuring bouquet garni and smoke cold flavors, this recipe is low carb friendly and perfect for a quick dinner",
  "cuisine": "Portuguese",
  "diet": [
    "low-carb",
    "gluten-free"
