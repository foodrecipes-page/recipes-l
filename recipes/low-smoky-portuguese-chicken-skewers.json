    {
      "name": "chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "smoked paprika",
      "amount": "2 tablespoons"
    },
    {
      "name": "bouquet garni",
      "amount": "1 packet"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat grill to 400 degrees Fahrenheit",
    "In a large bowl, whisk together olive oil, garlic, smoked paprika, salt, and black pepper",
    "Add the chicken to the bowl and toss to coat with the marinade",
    "Thread the chicken onto skewers, leaving a small space between each piece",
    "Grill the skewers for 10-12 minutes, turning occasionally",
    "Meanwhile, prepare the bouquet garni according to package instructions",
    "Once the chicken is cooked, brush with lemon juice and sprinkle with bouquet garni",
    "Serve hot and enjoy"
  ],
