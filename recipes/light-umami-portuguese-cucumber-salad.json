  "ingredients": [
    {
      "name": "Persian cucumber",
      "amount": "2 large",
      "notes": "peeled and thinly sliced"
    },
    {
      "name": "Red onion",
      "amount": "1 small",
      "notes": "thinly sliced"
    },
    {
      "name": "Fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "Extra virgin olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "White wine vinegar",
      "amount": "1 tablespoon"
    },
    {
      "name": "Salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "Black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "Kalamata olives",
      "amount": "1/4 cup",
      "notes": "pitted"
    },
    {
      "name": "Fresh mint",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "In a large bowl, combine the sliced persian cucumber and red onion",
    "In a small bowl, whisk together the olive oil, white wine vinegar, salt, and black pepper",
    "Pour the dressing over the cucumber mixture and toss to combine",
    "Stir in the chopped parsley, kalamata olives, and fresh mint",
    "Let the salad sit at room temperature for 15 minutes to allow the flavors to meld",
    "Just before serving, knead the salad gently with your hands to release the juices and combine the flavors",
    "Serve the salad chilled, garnished with additional parsley if desired",
    "Cover and refrigerate any leftovers for up to 24 hours"
  ],
