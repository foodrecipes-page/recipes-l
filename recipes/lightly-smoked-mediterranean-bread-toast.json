{
  "title": "Lightly Smoked Mediterranean Bread Toast",
  "description": "A pungent and cozy Mediterranean dish featuring stale bread, smoke-hot flavors, and no onion or garlic, perfect for a light snack or appetizer.",
  "cuisine": "Mediterranean",
  "diet": [
    "vegetarian",
    "gluten-free"
  ],
