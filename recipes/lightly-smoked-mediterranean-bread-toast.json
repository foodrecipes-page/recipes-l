  "ingredients": [
    {
      "name": "stale bread",
      "amount": "1 loaf",
      "notes": "preferably day-old bread"
    },
    {
      "name": "kalamata olives",
      "amount": "1/2 cup",
      "notes": "pitted"
    },
    {
      "name": "artichoke hearts",
      "amount": "1/2 cup",
      "notes": "canned"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbly"
    },
    {
      "name": "sun-dried tomatoes",
      "amount": "1/4 cup",
      "notes": "dried"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "Slice the stale bread into 1-inch thick slices and place on a baking sheet.",
    "Drizzle the olive oil over the bread and sprinkle with smoked paprika and salt.",
    "Bake the bread in the oven for 10 minutes, or until lightly toasted.",
    "While the bread is baking, mix the kalamata olives, artichoke hearts, feta cheese, sun-dried tomatoes, and parsley in a bowl.",
    "Once the bread is ready, let it cool for a minute or two before topping with the olive mixture.",
    "Drizzle the lemon juice over the top of the bread and serve immediately.",
    "Garnish with additional parsley if desired.",
    "Serve warm and enjoy."
  ],
