  "ingredients": [
    {
      "name": "chicken liver",
      "amount": "1 pound",
      "notes": "freshly sliced"
    },
    {
      "name": "infused oil",
      "amount": "2 tablespoons",
      "notes": "with herbs and spices"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the infused oil in the hot pot vessel over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the sliced chicken liver and cook until it is browned on all sides.",
    "Add the lemon juice, chicken broth, salt, and black pepper, and stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 20 minutes.",
    "Stir in the chopped parsley and serve hot.",
    "Ensure poultry is cooked to an internal temperature of 74°C / 165°F (juices run clear, no pink remaining) before serving."
  ],
