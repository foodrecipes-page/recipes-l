      "name": "Chilled butter",
      "amount": "2 tbsp"
    },
    {
      "name": "Tamarind paste",
      "amount": "2 tbsp"
    },
    {
      "name": "Palm sugar",
      "amount": "1 tbsp"
    },
    {
      "name": "Fish sauce",
      "amount": "1 tbsp"
    },
    {
      "name": "Bean sprouts",
      "amount": "1 cup"
    },
    {
      "name": "Chopped peanuts",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Heat the vegetable oil in a kadhai over medium heat",
    "Add the smoked paprika and stir for 1 minute",
    "Add the rice noodles and stir fry for 2 minutes",
    "Add the tamarind paste, palm sugar, and fish sauce, and stir fry for 2 minutes",
    "Add the bean sprouts and stir fry for 1 minute",
    "Stir in the chilled butter until melted",
    "Transfer the noodles to a serving platter",
    "Sprinkle the chopped peanuts over the top",
    "Serve immediately"
  ],
