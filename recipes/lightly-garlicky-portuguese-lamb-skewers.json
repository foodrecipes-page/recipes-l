{
  "title": "Lightly Garlicky Portuguese Lamb Skewers",
  "description": "A nostalgic Portuguese dish featuring rosemary and garlic, made kosher-friendly with a shio-cure, perfect for a summer dinner",
  "cuisine": "Portuguese",
  "diet": [
    "kosher"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "rosemary",
      "amount": "2 sprigs",
      "notes": "chopped"
    },
    {
      "name": "shio cure",
      "amount": "1 tablespoon",
      "notes": "or to taste"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the grill to 400 degrees Fahrenheit",
    "In a large bowl, whisk together olive oil, garlic, rosemary, shio cure, salt, and black pepper",
    "Add the lamb cubes to the bowl and toss to coat with the marinade",
    "Thread the lamb cubes onto skewers, leaving a small space between each piece",
    "Grill the skewers for 10-12 minutes, turning occasionally, until the lamb is cooked to 145 degrees Fahrenheit",
    "Let the skewers rest for 5 minutes before serving",
    "Serve hot, garnished with additional rosemary if desired"
  ],
