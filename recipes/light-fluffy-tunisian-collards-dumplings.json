  "ingredients": [
    {
      "name": "collard greens",
      "amount": "2 bunches",
      "notes": "chopped"
    },
    {
      "name": "all-purpose flour",
      "amount": "2 cups"
    },
    {
      "name": "semolina flour",
      "amount": "1 cup"
    },
    {
      "name": "granulated sugar",
      "amount": "1 cup"
    },
    {
      "name": "eggs",
      "amount": "4 large"
    },
    {
      "name": "unsalted butter",
      "amount": "1/2 cup",
      "notes": "melted"
    },
    {
      "name": "water",
      "amount": "1 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, whisk together the all-purpose flour, semolina flour, granulated sugar, and salt.",
    "In a separate bowl, whisk together the eggs, melted butter, and water.",
    "Add the wet ingredients to the dry ingredients and stir until just combined.",
    "Fold in the chopped collard greens.",
    "Using a spoon, drop the mixture into a greased 9x13 inch baking dish.",
    "Bake for 25 minutes, or until the dumplings are lightly golden brown.",
    "Remove from the oven and let cool for 5 minutes before serving."
  ],
