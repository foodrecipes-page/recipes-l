{
  "title": "Lightly Baked Turkish Eggplant Bake",
  "description": "A fresh and flavorful Turkish-inspired dish perfect for a spring brunch, featuring tender eggplant and a hint of rum, suitable for ovo-vegetarian diets.",
  "cuisine": "Turkish",
  "diet": [
    "ovo-vegetarian"
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "eggplant",
      "amount": "2 medium",
      "notes": "sliced into 1/2 inch thick rounds"
    },
    {
      "name": "appleton rum",
      "amount": "2 tablespoons",
      "notes": "optional"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "tomato",
      "amount": "2 large",
      "notes": "diced"
    },
    {
      "name": "feta cheese",
      "amount": "1 cup",
      "notes": "crumbled"
    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, appleton rum, salt, and black pepper.",
    "Add sliced eggplant to the bowl and toss to coat with the oil mixture.",
    "Spread half of the eggplant slices in the bottom of a 9x13 inch baking dish.",
    "In a separate bowl, mix together chopped onion, minced garlic, and diced tomato.",
    "Spread the onion mixture over the eggplant in the baking dish.",
    "Top with crumbled feta cheese and chopped parsley.",
    "Add the remaining eggplant slices on top.",
    "Bake for 35 minutes or until the eggplant is tender and lightly browned."
  ],
