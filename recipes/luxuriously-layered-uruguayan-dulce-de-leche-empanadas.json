      "name": "all-purpose flour",
      "amount": "2 cups",
      "notes": "for empanada dough"
    },
    {
      "name": "score fat",
      "amount": "1/2 cup",
      "notes": "for empanada dough"
    },
    {
      "name": "dulce de leche",
      "amount": "1 cup",
      "notes": "caramel sauce"
    },
    {
      "name": "ti leaves",
      "amount": "12",
      "notes": "for wrapping empanadas"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "sugar",
      "amount": "1 tablespoon",
      "notes": "to taste"
    }
  ],
  "instructions": [
    "Preheat oven to 375 degrees Fahrenheit",
    "Mix flour and score fat to make empanada dough",
    "Roll out empanada dough to a thickness of 1/8 inch",
    "Cut out circles of dough using a cookie cutter",
    "Place a tablespoon of dulce de leche in the center of each dough circle",
    "Fold dough in half to form a half-moon shape and press edges together",
    "Wrap each empanada in a ti leaf",
    "Place empanadas on a baking sheet lined with parchment paper",
    "Bake empanadas for 20 minutes or until golden brown"
