{
  "title": "Light Algerian Peas Salad",
  "description": "A refreshing and light salad featuring sugar snap peas, herbal flavors, and a delicate jelly-like dressing.",
  "cuisine": "algerian",
  "diet": [
    "pescatarian-friendly"
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "sugar snap peas",
      "amount": "12 oz (340g)"
    },
    {
      "name": "namul-blanch-season",
      "amount": "1 tsp (5g)"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup (15g)"
    },
    {
      "name": "fresh mint",
      "amount": "1/4 cup (15g)"
    },
    {
      "name": "lemon juice",
      "amount": "2 tbsp (30ml)"
    },
    {
      "name": "olive oil",
      "amount": "2 tbsp (30ml)"
    },
    {
      "name": "honey",
      "amount": "1 tsp (5g)"
    },
    {
      "name": "crushed red pepper",
      "amount": "1/4 tsp (1g)"
    },
    {
      "name": "salt",
      "amount": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "to taste"
    }
  ],
  "instructions": [
    "Rinse the sugar snap peas under cold water and pat them dry with a paper towel.",
    "Cut the sugar snap peas in half lengthwise and set them aside.",
    "In a small bowl, whisk together the namul-blanch-season, lemon juice, and olive oil.",
    "Add the honey, crushed red pepper, salt, and black pepper to the bowl and whisk until well combined.",
    "Toss the sugar snap peas with the dressing and let them sit at room temperature for at least 30 minutes.",
    "Just before serving, stir in the chopped fresh parsley and mint.",
    "Serve the Light Algerian Peas Salad chilled or at room temperature."
  ],
